{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bab_remix",
  "version": "0.2.0",
  "identifier": "lol.manu.tavu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "La République en mousse - Puppet Animation Studio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
